---
import { evidenceStates, siteLinks } from '../data/content'
---

<section id="safety" class="section-tinted" aria-labelledby="safety-title">
  <div class="container evidence-layout">
    <div class="section-heading">
      <p class="kicker">04 / Evidence &amp; safety</p>
      <h2 id="safety-title">Know what the result proves.</h2>
      <p>An accepted submission proves neither crawl nor indexation.</p>
      <a class="text-link" href={siteLinks.bingContract}>Read the Bing API contract <span aria-hidden="true">→</span></a>
    </div>
    <dl class="evidence-states">
      {evidenceStates.map(([title, copy]) => (
        <div>
          <dt>{title}</dt>
          <dd>{copy}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>
