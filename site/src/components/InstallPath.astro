---
import { installSteps, siteLinks } from '../data/content'
const targets = ['install-evaluate', 'install-persistent', 'install-verify'] as const
const commands = ['uvx gsc-mcp-tools', 'uv tool install gsc-mcp-tools', 'gsc-cli list'] as const
const copyLabels = ['Copy evaluate command', 'Copy persistent install command', 'Copy verification command'] as const
---

<section id="install" aria-labelledby="install-title">
  <div class="container">
    <div class="section-heading">
      <p class="kicker">03 / Get started</p>
      <h2 id="install-title">A small setup. A deliberate first check.</h2>
      <p>Choose an install path, connect your MCP client, then verify provider access.</p>
    </div>
    <ol class="install-grid">
      {installSteps.map(([title, copy], index) => (
        <li id={targets[index]}>
          <span class="step-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <h3>{title}</h3>
          <p>{copy}</p>
          <div class="command-row">
            <code tabindex="0">{commands[index]}</code>
            <button type="button" data-copy-command={commands[index]} aria-controls={`${targets[index]}-copy-status`}>{copyLabels[index]}</button>
          </div>
          {index === 2 && <p class="expected-result">Expected: the registered commands and their one-line descriptions.</p>}
          <p id={`${targets[index]}-copy-status`} class="copy-status" data-copy-status role="status" aria-live="polite"></p>
        </li>
      ))}
    </ol>
    <a class="text-link" href={siteLinks.install}>Read the client-specific installation guide <span aria-hidden="true">→</span></a>
  </div>
</section>
