---
import { getSiteLinks, landingContent, type Locale } from '../data/content'
interface Props { locale: Locale }
const { locale } = Astro.props
const content = landingContent[locale].workflow
const links = getSiteLinks(locale)
---

<section id="workflow" class="section-tinted" aria-labelledby="workflow-title">
  <div class="container">
    <div class="section-heading">
      <p class="kicker">{content.kicker}</p>
      <h2 id="workflow-title">{content.title}</h2>
    </div>
    <ol class="workflow-list">
      {content.steps.map(([title, copy], index) => (
        <li>
          <span class="step-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <h3>{title}</h3>
          <p>{copy}</p>
        </li>
      ))}
    </ol>
    <p>{locale === 'fr' ? 'Pour un audit natif à budget borné avec des profils sélectionnés, consultez le ' : 'For a native audit with bounded attempts and selected roles, read the '}<a class="text-link" href={links.nativeAudit}>{locale === 'fr' ? 'guide du workflow source' : 'source workflow guide'}</a>{locale === 'fr' ? '. Les API expérimentales sont incluses dans 1.6.0 ; le lanceur et les skills nécessitent le dépôt.' : '. The experimental APIs are packaged in 1.6.0; the runner and skills require a checkout.'}</p>
  </div>
</section>
