---
import { Icon } from '@astrojs/starlight/components'
import { getNavigationSections } from '../data/navigation'
import { getSiteLinks, landingContent, type Locale } from '../data/content'

interface Props { locale: Locale; alternatePaths?: Record<Locale, string> }
const { locale, alternatePaths } = Astro.props
const content = landingContent[locale].header
const links = getSiteLinks(locale)
const navigationSections = getNavigationSections(locale)
const hrefFor = (href: string) => href.startsWith('#') && Astro.url.pathname !== links.home ? `${links.home}${href}` : href
const otherLocale = locale === 'fr' ? 'en' : 'fr'
---

<a class="skip-link" href="#main-content">{content.skip}</a>
<header class="site-header" data-site-header>
  <div class="container header-inner">
    <a class="wordmark" href={links.home} aria-label={content.home}>
      <span class="creator-mark" aria-hidden="true">FB<span>.</span></span>
      <span>Search Console MCP</span>
    </a>
    <button id="mobile-menu-toggle" type="button" aria-label={content.open} data-open-label={content.open} data-close-label={content.close} aria-expanded="false" aria-controls="primary-navigation">
      <span>Menu</span><span aria-hidden="true">☰</span>
    </button>
    <div class="nav-backdrop" data-nav-backdrop hidden></div>
    <div id="primary-navigation">
      <nav aria-label={content.navigation}>
        <div class="mobile-nav-heading">
          <strong>{content.explore}</strong>
          <button type="button" data-mobile-menu-close aria-label={content.close}>×</button>
        </div>
        <div class="nav-sections">
          {navigationSections.map((section) => (
            <details data-nav-section={section.id}>
              <summary role="button" data-nav-trigger={section.id} aria-expanded="false" aria-controls={`nav-panel-${section.id}`}>
                {section.label}
                <svg class="nav-chevron" width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false">
                  <path d="m4 6 4 4 4-4" />
                </svg>
              </summary>
              <section id={`nav-panel-${section.id}`} class="nav-panel" data-nav-panel={section.id} aria-labelledby={`nav-title-${section.id}`}>
                <div class="nav-panel-heading">
                  <h2 id={`nav-title-${section.id}`}>{section.label}</h2>
                  <p>{section.description}</p>
                  <a href={hrefFor(section.overview.href)} target={section.overview.external ? '_blank' : undefined} rel={section.overview.external ? 'noopener noreferrer' : undefined}>
                    {section.overview.label}
                    <svg class="nav-overview-arrow" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false">
                      <path d="M3 8h10m-4-4 4 4-4 4" />
                    </svg>
                    {section.overview.external && <span class="sr-only"> (opens in a new tab)</span>}
                  </a>
                </div>
                <div class="nav-panel-groups">
                  {section.groups.map((group) => (
                    <div class="nav-panel-group">
                      <h3>{group.label}</h3>
                      <ul>
                        {group.links.map((link) => (
                          <li>
                            <a href={hrefFor(link.href)} target={link.external ? '_blank' : undefined} rel={link.external ? 'noopener noreferrer' : undefined}>
                              <strong>{link.label}</strong>
                              <span>{link.description}</span>
                              {link.external && <span class="sr-only"> ({content.external})</span>}
                            </a>
                          </li>
                        ))}
                      </ul>
                    </div>
                  ))}
                </div>
              </section>
            </details>
          ))}
        </div>
        <div class="header-actions">
          <a href={links.docs}>{content.docs}</a>
          <span class="header-divider" aria-hidden="true"></span>
          <a class="header-language" href={alternatePaths?.[otherLocale] ?? links.otherHome} lang={content.languageCode} hreflang={content.languageCode}>
            <svg class="header-action-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9" /><ellipse cx="12" cy="12" rx="4" ry="9" /><path d="M3 12h18" /></svg>
            {content.language}
          </a>
          <a class="header-github" href={links.repository} target="_blank" rel="noopener noreferrer">
            <Icon name="github" size="20" />
            <span class="sr-only">GitHub ({content.external})</span>
          </a>
          <button class="theme-toggle" type="button" data-theme-toggle data-theme-dark-label={content.themeDark} data-theme-light-label={content.themeLight} aria-label={content.themeDark}>
            <svg class="header-action-icon theme-icon-light" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="M20.5 13A8.5 8.5 0 0 1 11 3.5 8.5 8.5 0 1 0 20.5 13Z" /></svg>
            <svg class="header-action-icon theme-icon-dark" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="4" /><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5" /></svg>
          </button>
          <a class="header-install" href={hrefFor('#install')}>{content.install}<svg class="header-action-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="M7 17 17 7M7 7h10v10" /></svg></a>
        </div>
      </nav>
    </div>
  </div>
</header>
