---
import { providers } from '../data/content'
---

<section id="capabilities" aria-labelledby="capabilities-title">
  <div class="container">
    <div class="section-heading">
      <p class="kicker">01 / Capabilities</p>
      <h2 id="capabilities-title">Three sources. Explicit boundaries.</h2>
      <p>Start with the evidence your question needs.</p>
    </div>
    <div class="provider-grid">
      {providers.map((provider) => (
        <article id={`provider-${provider.id}`} class={`provider-card provider-${provider.id}`} aria-labelledby={`provider-title-${provider.id}`}>
          <h3 id={`provider-title-${provider.id}`}>{provider.title}</h3>
          <p>{provider.copy}</p>
          <ul>{provider.items.map((item) => <li>{item}</li>)}</ul>
        </article>
      ))}
    </div>
    <p class="boundary-note">Google and Bing position semantics remain separate.</p>
  </div>
</section>
