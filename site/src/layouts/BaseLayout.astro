---
import '../styles/global.css'
import type { Locale } from '../data/content'

interface Props {
  title: string
  description: string
  image?: string
  imageAlt?: string
  lang?: Locale
  alternatePaths?: Record<Locale, string>
  jsonLd?: Record<string, unknown>[]
}

const {
  title,
  description,
  image = '/og-image.png',
  imageAlt = 'Search Console MCP: Google, Bing and SEO analytics for AI assistants.',
  lang = 'en',
  alternatePaths,
  jsonLd = [],
} = Astro.props
const canonical = new URL(Astro.url.pathname, Astro.site)
const socialImage = new URL(image, Astro.site)
const ogLocale = lang === 'fr' ? 'fr_FR' : 'en_US'
---

<!doctype html>
<html lang={lang}>
  <head>
    <script is:inline>
      (() => {
        let saved = null
        try { saved = localStorage.getItem('theme') } catch {}
        const systemDark = matchMedia('(prefers-color-scheme: dark)').matches
        document.documentElement.dataset.theme = saved === 'light' || saved === 'dark'
          ? saved
          : systemDark ? 'dark' : 'light'
      })()
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternatePaths && <>
      <link rel="alternate" hreflang="en" href={new URL(alternatePaths.en, Astro.site)} />
      <link rel="alternate" hreflang="fr" href={new URL(alternatePaths.fr, Astro.site)} />
      <link rel="alternate" hreflang="x-default" href={new URL(alternatePaths.en, Astro.site)} />
    </>}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:site_name" content="Search Console MCP" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    {jsonLd.map((entry) => (
      <script type="application/ld+json" set:html={JSON.stringify(entry)} />
    ))}
  </head>
  <body>
    <slot />
    <script>
      import '../scripts/interactions'
    </script>
  </body>
</html>
